# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Google AI Studio → Get API key (phase 2)
GEMINI_API_KEY=
# Optional. Suspects' model. Defaults to gemini-flash-lite-latest.
GEMINI_MODEL=
# Optional. Case generator's model. Defaults to gemini-flash-latest.
GEMINI_GENERATOR_MODEL=
# Optional. Model that tries to solve generated cases. Defaults to gemini-flash-lite-latest.
GEMINI_SOLVER_MODEL=

# Optional. Max AI answers per day for the whole app (protects the free tier). Default 1000.
AI_DAILY_LIMIT=

# Vercel Cron sends this as a Bearer token to /api/cron/publish. Any random 32+ characters,
# e.g. from: openssl rand -hex 32
CRON_SECRET=

# Cloudflare Turnstile (anti-bot for anonymous sign-in). Leave empty to skip in dev.
# The secret key goes into Supabase: Authentication → Attack Protection → CAPTCHA.
# Cloudflare test keys: site 1x00000000000000000000BB (invisible, always passes),
# secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
