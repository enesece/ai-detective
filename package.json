{
  "name": "ai-detective",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:leaks": "node scripts/check-secret-leaks.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "check:prompts": "node --conditions=react-server --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-prompt-isolation.mts",
    "db:seed": "tsx --env-file=.env.local scripts/seed-cases.mts",
    "smoke": "tsx --env-file=.env.local scripts/smoke-api.mts",
    "check:guard": "tsx scripts/check-guard.mts",
    "eval": "tsx --conditions=react-server --env-file=.env.local scripts/eval-injection.mts",
    "generate": "tsx --conditions=react-server --env-file=.env.local scripts/generate-case.mts",
    "check:solver": "node --conditions=react-server --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-solver-isolation.mts",
    "eval:consistency": "tsx --conditions=react-server --env-file=.env.local scripts/eval-consistency.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
